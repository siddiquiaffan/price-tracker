# --- Core (required) ---
BOT_TOKEN=123456:ABC-your-telegram-bot-token
API_KEY=change-me
DB_URL=mongodb://localhost:27017
ADMINS=123456789

# --- Optional ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DB_NAME=AS_TRACKER
LIMIT=5
TELEGRAM_SECRET_TOKEN=
WEBHOOK_URL=
AMAZON_AFFILIATE_TAG=asloot-21
NOTIFY_STRATEGY=every-change
NOTIFY_THRESHOLD_PERCENT=0
SCHEDULE_INTERVAL_MS=3600000
SCHEDULE_JITTER_RATIO=0.1
REQUEST_TIMEOUT_MS=15000
REDIS_URL=

# --- Egress (optional; pick one style) ---
# New style: JSON with ${ENV_VAR} interpolation (or a path to a JSON file).
# EGRESS_CONFIG={"defaultPool":"default","pools":{"default":{"strategy":"round-robin","providers":[{"id":"direct","type":"direct"}]}}}
# Legacy shims (kept working for compatibility):
# PROXY=http://user:pass@proxy.example.com:8080
# WORKER_URL=https://your-worker.example.workers.dev/fetch